        "text": "=❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "1a000000-0000-4000-8000-00000000a009",
      "name": "Enviar erro",
      "type": "n8n-nodes-base.telegram",
